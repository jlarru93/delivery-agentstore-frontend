{
  "name": "pospiwi",
  "version": "12.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --host 0.0.0.0 --disable-host-check --port 4200",
    "start:prod": "ng serve --configuration prod",
    "build": "ng build",
    "build-dev": "ng build --configuration dev",
    "build-dev-spa": "ng build --configuration dev --source-map",
    "build-qa": "ng build --configuration qa",
    "build-prod": "ng build --configuration prod",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build:cap": "ng build --configuration dev",
    "cap:assets": "npx capacitor-assets generate --android",
    "cap:sync": "npm run build:cap && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios"
  },
  "private": true,
